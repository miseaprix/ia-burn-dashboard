# Fictional example: "Acme Corp" exposes an AI gateway branded "Acme AI".
# Nothing here is real: the domain uses the reserved .example TLD and the token is a placeholder.
# Usage: copy the lines you need into .env (see .env.example for every other variable).

# Display name of the enterprise source in the UI.
ENTERPRISE_LABEL=Acme AI
# Gateway token (prefer entering the API key in Admin, where it is stored encrypted).
ANTHROPIC_AUTH_TOKEN=sk-acme-example-not-a-real-key
# Gateway URL; enables the enterprise source (takes precedence over ANTHROPIC_BASE_URL).
ENTERPRISE_BASE_URL=https://ai-gateway.acme.example
# Monthly budget tracked by Burn (does not change the gateway's own budget).
ENTERPRISE_BUDGET=500
# OpenCode provider ids counted as enterprise usage (comma-separated).
ENTERPRISE_OPENCODE_PROVIDERS=acme-ai
# Keep TLS verification on; for an internal CA mount it and set NODE_EXTRA_CA_CERTS.
ENTERPRISE_INSECURE_TLS=0

# Host directories holding the local logs of the Acme-configured harnesses (read-only).
ENTERPRISE_CLAUDE_DATA_DIR=${HOME}/.claude-acme
ENTERPRISE_CODEX_DATA_DIR=${HOME}/.codex-acme
ENTERPRISE_OPENCODE_DATA_DIR=${HOME}/.local/share/opencode
# Host file with ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL exports (read, never sourced).
ENTERPRISE_ENV_HOST_FILE=${HOME}/.config/acme-ai/env

# Set by docker-compose.yml inside the container, not in .env:
# ENTERPRISE_ENV_FILE, ENTERPRISE_CLAUDE_DIR, ENTERPRISE_CODEX_DIR, ENTERPRISE_OPENCODE_DB.
