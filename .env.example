# Copy to .env. Configure your API key in Admin; startup token is optional.
# Enterprise gateway (optional source). Without a base URL the source is disabled.
# Display name of the enterprise source in the UI.
ENTERPRISE_LABEL=Enterprise
ANTHROPIC_AUTH_TOKEN=
# ENTERPRISE_BASE_URL takes precedence over ANTHROPIC_BASE_URL.
ENTERPRISE_BASE_URL=
ANTHROPIC_BASE_URL=
ENTERPRISE_BUDGET=300
# OpenCode provider ids counted as enterprise usage (comma-separated).
ENTERPRISE_OPENCODE_PROVIDERS=
# Verification enabled. For an internal CA, mount it and set NODE_EXTRA_CA_CERTS.
# Temporary test-only escape hatch, scoped to corporate calls:
ENTERPRISE_INSECURE_TLS=0

# Host bind paths. Defaults use HOME; Windows PowerShell needs absolute paths.
CLAUDE_DATA_DIR=
CODEX_DATA_DIR=
# Enterprise local logs (RO): ~/.claude-enterprise, ~/.codex-enterprise, ~/.local/share/opencode.
ENTERPRISE_CLAUDE_DATA_DIR=
ENTERPRISE_CODEX_DATA_DIR=
ENTERPRISE_OPENCODE_DATA_DIR=
# Host file with ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL exports (read, never sourced).
ENTERPRISE_ENV_HOST_FILE=
CLAUDE_ACCOUNT_PATH=
# Optional native Agent Burn quota cache directory (native-cache compose override).
CLAUDE_NATIVE_CACHE_DIR=
# Native quota archive directory; auto-detected by deploy.sh on macOS.
CLAUDE_NATIVE_HISTORY_DIR=
# If the native archive has several sources, select the exact cliPath|codexHomes key.
AGENT_BURN_HISTORY_SOURCE=
# Personal subscription label/price fallback; detected plans take precedence.
CLAUDE_PLAN=max5x
CODEX_PLAN=plus
# Optional actual monthly price (e.g. 100, 200 or 500); generic Pro is not priced by inference.
CODEX_MONTHLY_PRICE=
BURN_PORT=4090
# Container port must match compose and the image healthcheck.
PORT=8080

# Stable history alias. Use a different value when switching log datasets/accounts.
# Keep the same value when credentials rotate. Personal/corporate are isolated.
USAGE_HISTORY_DATASET=default

# Optional IANA timezone; deploy.sh detects the host timezone when blank.
TZ=

# Autonomous collection intervals in milliseconds (minimum 1000).
LOCAL_COLLECT_MS=60000
QUOTA_COLLECT_MS=60000
CORPORATE_COLLECT_MS=300000

# Public price catalog refresh (default 6 hours; minimum 60000 ms).
PRICING_REFRESH_MS=21600000

# Single-user dashboard/Admin are bound to loopback by default.
BURN_BIND_HOST=127.0.0.1

# Optional local Monitoring receiver; no hooks are installed or redirected automatically.
MONITOR_INGEST_ENABLED=0

# Docker volume holding the state database (see README to migrate an existing one).
IA_BURN_VOLUME=ia-burn_burn-state
